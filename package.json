{
  "name": "oh-my-teams",
  "version": "1.6.0",
  "description": "A PM/PL/Senior/Junior/Worker agent organization plugin for Claude Code and Codex, running on Orca.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inho-team/oh-my-teams.git"
  },
  "bugs": {
    "url": "https://github.com/inho-team/oh-my-teams/issues"
  },
  "homepage": "https://github.com/inho-team/oh-my-teams#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "npm run quality && npm run format:check",
    "quality": "node scripts/check-code-quality.mjs",
    "format": "prettier --write \"**/*.{mjs,json}\"",
    "format:check": "prettier --check \"**/*.{mjs,json}\"",
    "eval:organization": "node evals/organization/run.mjs",
    "org": "node plugins/oh-my-teams/scripts/teams-org.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
