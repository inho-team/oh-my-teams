{
  "name": "oh-my-teams",
  "version": "3.0.0",
  "description": "Orca worktree ownership skills for Claude Code and Codex.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{mjs,json}\"",
    "format:check": "prettier --check \"**/*.{mjs,json}\"",
    "sync": "node scripts/metadata.mjs --write",
    "sync:check": "node scripts/metadata.mjs",
    "quality": "node scripts/check-skills.mjs",
    "lint": "npm run quality && npm run format:check && npm run sync:check",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
