{
  "name": "oh-my-teams",
  "version": "3.2.0",
  "description": "Orca worktree ownership skills for Claude Code and Codex.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{mjs,json,yaml}\"",
    "format:check": "prettier --check \"**/*.{mjs,json,yaml}\"",
    "sync": "node scripts/metadata.mjs --write && node scripts/runtime-build.mjs --write",
    "sync:check": "node scripts/metadata.mjs && node scripts/runtime-build.mjs",
    "documents": "node scripts/documents.mjs",
    "quality": "node scripts/check-source.mjs && node scripts/check-skills.mjs && node scripts/check-docs.mjs",
    "lint": "npm run quality && npm run format:check && npm run sync:check",
    "test": "node --test tests/*.test.mjs examples/*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "npm run lint && npm test"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint-scope": "9.1.2",
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-string": "4.0.0",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  }
}
