{
  "schemaVersion": 1,
  "revision": 1,
  "name": "example-opus-first-team",
  "pools": { "agy-shared": { "label": "User-selected shared Agy quota" } },
  "profiles": {
    "claude-current": {
      "provider": "claude",
      "command": ["claude"],
      "account": "current",
      "subscription": "User-selected Claude subscription",
