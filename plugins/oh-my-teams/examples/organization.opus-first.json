    "intern": {
      "parent": "junior",
      "profile": "agy-opus",
      "concurrency": 3,
      "attempts": 1,
      "fallbacks": []
    }
  },
  "policy": {
    "onExhaustion": "stop",
    "maxCalls": 2,
    "timeoutMs": 300000,
    "repeatFailureLimit": 1
