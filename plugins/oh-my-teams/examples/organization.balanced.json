{
  "schemaVersion": 1,
  "revision": 1,
  "name": "example-balanced-team",
  "pools": {
    "agy-shared": {
      "label": "User-selected shared Agy quota"
    }
  },
  "profiles": {
    "claude-current": {
      "provider": "claude",
      "command": ["claude"],
      "account": "current",
      "subscription": "User-selected Claude subscription",
      "model": null
    },
    "codex-current": {
      "provider": "codex",
      "command": ["codex"],
      "account": "current",
      "subscription": "User-selected Codex subscription",
      "model": null
    },
    "agy-oss": {
      "provider": "agy",
      "command": ["agy"],
      "account": "current",
      "subscription": "User-selected shared Agy pool",
      "model": "gpt-oss-120b-medium",
      "pool": "agy-shared"
    },
    "agy-sonnet": {
      "provider": "agy",
      "command": ["agy"],
      "account": "current",
      "subscription": "User-selected shared Agy pool",
      "model": "claude-sonnet-4-6",
      "pool": "agy-shared"
    },
    "agy-opus": {
      "provider": "agy",
      "command": ["agy"],
      "account": "current",
      "subscription": "User-selected shared Agy pool",
      "model": "claude-opus-4-6-thinking",
      "pool": "agy-shared"
    }
  },
  "roles": {
    "pm": {
      "parent": null,
      "profile": "claude-current",
      "concurrency": 1,
      "attempts": 1,
      "fallbacks": []
    },
    "pl": {
      "parent": "pm",
      "profile": "codex-current",
      "concurrency": 1,
      "attempts": 1,
      "fallbacks": []
    },
    "senior": {
      "parent": "pl",
      "profile": "agy-opus",
      "concurrency": 1,
      "attempts": 1,
      "fallbacks": []
    },
    "junior": {
      "parent": "pl",
      "profile": "agy-sonnet",
      "concurrency": 1,
      "attempts": 1,
      "fallbacks": ["agy-opus"]
    },
    "intern": {
      "parent": "junior",
      "profile": "agy-oss",
      "concurrency": 1,
      "attempts": 1,
      "fallbacks": ["agy-sonnet"]
    }
  },
  "policy": {
    "onExhaustion": "fallback",
    "maxCalls": 3,
    "timeoutMs": 300000,
    "repeatFailureLimit": 1
  }
}
