{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OMT document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "issued_at",
    "issuer",
    "subject",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "review_request",
        "review_result",
        "status_report",
        "task_request",
        "completion_report",
        "interruption_report"
      ]
    },
    "id": {
      "$ref": "#/definitions/text"
    },
    "issued_at": {
      "$ref": "#/definitions/timestamp"
    },
    "in_reply_to": {
      "$ref": "#/definitions/text"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id"],
      "properties": {
        "session_id": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree_id"],
      "properties": {
        "worktree_id": {
          "$ref": "#/definitions/text"
        },
        "commit": {
          "$ref": "#/definitions/commit"
        },
        "implementation_session_id": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review_request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/reviewRequest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review_result"
          }
        }
      },
      "then": {
        "required": ["in_reply_to"],
        "properties": {
          "in_reply_to": {
            "$ref": "#/definitions/text"
          },
          "payload": {
            "$ref": "#/definitions/reviewResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "status_report"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/statusReport"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task_request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/taskRequest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "completion_report"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/completionReport"
          },
          "in_reply_to": {
            "$ref": "#/definitions/text"
          }
        },
        "required": ["in_reply_to"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "interruption_report"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/definitions/interruptionReport"
          },
          "in_reply_to": {
            "$ref": "#/definitions/text"
          }
        },
        "required": ["in_reply_to"]
      }
    }
  ],
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/text"
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "locator"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["file", "git", "orca", "ci", "user"]
        },
        "locator": {
          "$ref": "#/definitions/text"
        },
        "excerpt": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "reviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "question",
        "facts",
        "options",
        "constraints",
        "acceptance_criteria",
        "evidence"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "enum": ["advisor", "lawyer", "auditor"]
        },
        "question": {
          "$ref": "#/definitions/text"
        },
        "facts": {
          "$ref": "#/definitions/texts"
        },
        "options": {
          "$ref": "#/definitions/texts"
        },
        "constraints": {
          "$ref": "#/definitions/texts"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    },
    "reviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "conclusion",
        "summary",
        "recommendation",
        "counterarguments",
        "independent",
        "findings",
        "uncertainties",
        "evidence"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "enum": ["advisor", "lawyer", "auditor"]
        },
        "conclusion": {
          "type": "string",
          "enum": [
            "recommended",
            "changes_requested",
            "no_findings",
            "inconclusive"
          ]
        },
        "summary": {
          "$ref": "#/definitions/text"
        },
        "recommendation": {
          "$ref": "#/definitions/text"
        },
        "counterarguments": {
          "$ref": "#/definitions/texts"
        },
        "independent": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "description", "evidence"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "description": {
                "$ref": "#/definitions/text"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/evidence"
                }
              }
            }
          }
        },
        "uncertainties": {
          "$ref": "#/definitions/texts"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "build_id",
        "source_commit",
        "target_branch",
        "status",
        "observed_at"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/text"
        },
        "build_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_commit": {
          "anyOf": [
            {
              "$ref": "#/definitions/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_branch": {
          "anyOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "unregistered",
            "queued",
            "running",
            "passed",
            "failed",
            "cancelled",
            "skipped",
            "unknown"
          ]
        },
        "observed_at": {
          "$ref": "#/definitions/timestamp"
        }
      }
    },
    "statusReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "observation",
        "execution",
        "worktree",
        "git",
        "ci",
        "delivery",
        "cleanup",
        "remaining",
        "uncertainties",
        "evidence"
      ],
      "properties": {
        "summary": {
          "$ref": "#/definitions/text"
        },
        "observation": {
          "type": "string",
          "enum": ["complete", "partial", "failed"]
        },
        "execution": {
          "type": "string",
          "enum": ["unknown", "running", "succeeded", "failed", "stopped"]
        },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "instance_id", "owner_session_id"],
          "properties": {
            "id": {
              "$ref": "#/definitions/text"
            },
            "instance_id": {
              "$ref": "#/definitions/text"
            },
            "owner_session_id": {
              "anyOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "git": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["head", "dirty"],
              "properties": {
                "head": {
                  "$ref": "#/definitions/commit"
                },
                "dirty": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "ci": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ci"
          }
        },
        "delivery": {
          "$ref": "#/definitions/delivery"
        },
        "cleanup": {
          "$ref": "#/definitions/cleanup"
        },
        "remaining": {
          "$ref": "#/definitions/texts"
        },
        "uncertainties": {
          "$ref": "#/definitions/texts"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reference"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["not_requested", "pending", "delivered", "unknown"]
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "remaining"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_requested",
            "pending",
            "completed",
            "preserved",
            "unknown"
          ]
        },
        "remaining": {
          "$ref": "#/definitions/texts"
        }
      }
    },
    "taskRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "scope",
        "acceptance_criteria",
        "constraints",
        "required_checks",
        "delivery",
        "cleanup_required",
        "evidence"
      ],
      "properties": {
        "goal": {
          "$ref": "#/definitions/text"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "minItems": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "minItems": 1
        },
        "constraints": {
          "$ref": "#/definitions/texts"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "command"],
            "properties": {
              "name": {
                "$ref": "#/definitions/text"
              },
              "command": {
                "$ref": "#/definitions/text"
              }
            }
          },
          "minItems": 0
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "target", "authorization"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["none", "commit", "pr", "merge", "artifact"]
            },
            "target": {
              "anyOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "type": "null"
                }
              ]
            },
            "authorization": {
              "anyOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "cleanup_required": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          },
          "minItems": 0
        }
      }
    },
    "completionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "outcome",
        "acceptance_results",
        "checks",
        "ci",
        "delivery",
        "cleanup",
        "remaining",
        "uncertainties",
        "evidence"
      ],
      "properties": {
        "summary": {
          "$ref": "#/definitions/text"
        },
        "outcome": {
          "type": "string",
          "enum": ["completed", "incomplete"]
        },
        "acceptance_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "result", "evidence"],
            "properties": {
              "criterion": {
                "$ref": "#/definitions/text"
              },
              "result": {
                "type": "string",
                "enum": ["met", "unmet", "unknown"]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/evidence"
                },
                "minItems": 0
              }
            }
          },
          "minItems": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required", "status", "command", "evidence"],
            "properties": {
              "name": {
                "$ref": "#/definitions/text"
              },
              "required": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "unknown",
                  "skipped",
                  "unregistered"
                ]
              },
              "command": {
                "$ref": "#/definitions/text"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/evidence"
                },
                "minItems": 0
              }
            }
          },
          "minItems": 0
        },
        "ci": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ci"
          },
          "minItems": 0
        },
        "delivery": {
          "$ref": "#/definitions/delivery"
        },
        "cleanup": {
          "$ref": "#/definitions/cleanup"
        },
        "remaining": {
          "$ref": "#/definitions/texts"
        },
        "uncertainties": {
          "$ref": "#/definitions/texts"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          },
          "minItems": 0
        }
      }
    },
    "interruptionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "reason",
        "undelivered_changes",
        "sessions",
        "delivery",
        "cleanup",
        "resume_steps",
        "uncertainties",
        "evidence"
      ],
      "properties": {
        "summary": {
          "$ref": "#/definitions/text"
        },
        "reason": {
          "$ref": "#/definitions/text"
        },
        "undelivered_changes": {
          "$ref": "#/definitions/texts"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "worktree_id",
              "instance_id",
              "liveness",
              "action",
              "stop_authorization"
            ],
            "properties": {
              "session_id": {
                "$ref": "#/definitions/text"
              },
              "worktree_id": {
                "$ref": "#/definitions/text"
              },
              "instance_id": {
                "$ref": "#/definitions/text"
              },
              "liveness": {
                "type": "string",
                "enum": ["running", "exited", "unknown"]
              },
              "action": {
                "type": "string",
                "enum": ["preserved", "stop_requested", "stopped"]
              },
              "stop_authorization": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/text"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 0
        },
        "delivery": {
          "$ref": "#/definitions/delivery"
        },
        "cleanup": {
          "$ref": "#/definitions/cleanup"
        },
        "resume_steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "minItems": 1
        },
        "uncertainties": {
          "$ref": "#/definitions/texts"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          },
          "minItems": 0
        }
      }
    }
  }
}
