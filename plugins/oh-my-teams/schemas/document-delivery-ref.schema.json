{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oh my teams `06. 인도` delivery-ref document v1",
  "$comment": "docs/plan/structured-omt-documents.md 3.2 (06. 인도 row), 3.7 item 7 (localId = kickoff entry's own `delivered.mergeCommit`), 3.7 contract B (written only once `entry.delivered` already exists, so it is recorded resolved from the start).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "docId",
    "stage",
    "kickoffId",
    "workflowId",
    "revision",
    "state",
    "author",
    "createdAt",
    "basedOnRevision",
    "reason",
    "evidenceRef",
    "reportRef",
    "deliveredCommit"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "docId": { "type": "string", "minLength": 1 },
    "stage": { "const": "delivery" },
    "kickoffId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workflowId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "state": {
      "const": "resolved",
      "$comment": "3.7 contract B: delivery-ref is written from the kickoff entry's already-recorded `entry.delivered`, never as a draft."
    },
    "author": { "$ref": "#/$defs/author" },
    "createdAt": { "type": "string", "format": "date-time" },
    "basedOnRevision": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    },
    "reason": { "type": "string", "minLength": 1 },
    "evidenceRef": {
      "$ref": "#/$defs/ref",
      "$comment": "Points at the content-addressed evidence record (1.2 table #15, `<store>/<key>.json`)."
    },
    "reportRef": {
      "$ref": "#/$defs/ref",
      "$comment": "Points at `<stateDir>/runs/<runId>/report.json` (1.2 table #18)."
    },
    "deliveredCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "$comment": "entry.delivered.mergeCommit (kickoff-registry.mjs), a git commit sha."
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "executionId"],
      "properties": {
        "role": { "enum": ["director", "pm", "pl", "senior", "junior"] },
        "executionId": { "type": "string", "minLength": 1 }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
