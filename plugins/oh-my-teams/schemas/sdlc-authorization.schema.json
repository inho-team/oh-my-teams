{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oh my teams deployment authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "lifecycleId", "releaseId", "releaseRevision", "sourceHash", "repository", "environment", "actions", "authority", "issuedAt", "expiresAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "lifecycleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "releaseRevision": { "type": "integer", "minimum": 1 },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repository": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["deploy", "rollback"] } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "signature"], "properties": { "kind": { "enum": ["human", "policy"] }, "id": { "type": "string", "minLength": 1 }, "signature": { "type": "string", "minLength": 1 } } },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
