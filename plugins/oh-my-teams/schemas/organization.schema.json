{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oh my teams organization",
  "type": "object",
  "required": ["schemaVersion", "revision", "name", "roles", "policy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "documentSystemActivatedAt": {
      "type": "string",
      "format": "date-time",
      "$comment": "docs/plan/structured-omt-documents.md 3.10: ISO time the structured .omt document system was activated for this organization. Deliberately omitted from `required` so organizations saved before wave-2 remain valid; review/decision/evidence files created before this field is set are legacyRef targets, and files created after it is set must have a matching structured document (3.10 판정 근거)."
    },
    "modelPolicy": {
      "type": "object",
      "required": ["preset", "revision"],
      "properties": {
        "preset": {
          "enum": [
            "custom",
            "opus-first",
            "balanced",
            "single-subscription",
            "advisor-codex",
            "advisor-claude"
          ]
        },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "pools": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/pool" }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "resources": {
      "type": "object",
      "$comment": "New organizations register verified subscription resources and fixed role authority without preselecting a model. Legacy profiles remain a compatibility input.",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "assistants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pm": { "$ref": "#/$defs/assistantProfiles" },
        "pl": { "$ref": "#/$defs/assistantProfiles" },
        "senior": { "$ref": "#/$defs/assistantProfiles" },
        "junior": { "$ref": "#/$defs/assistantProfiles" }
      }
    },
    "advisors": {
      "type": "object",
      "$comment": "Profiles each role may consult through advise. Unlike assistants, any model is allowed; the advice budget in policy.adviceBudget caps the calls.",
      "additionalProperties": false,
      "properties": {
        "pm": { "$ref": "#/$defs/assistantProfiles" },
        "pl": { "$ref": "#/$defs/assistantProfiles" },
        "senior": { "$ref": "#/$defs/assistantProfiles" },
        "junior": { "$ref": "#/$defs/assistantProfiles" }
      }
    },
    "roles": {
      "type": "object",
      "required": ["pm"],
      "$comment": "A reduced organization declares only the roles it runs, so only PM is required. Work addressed to an omitted role folds onto the closest declared senior role; core.mjs resolveRole performs that fold and validateOrg rejects a parent the organization does not declare.",
      "additionalProperties": false,
      "properties": {
        "pm": { "$ref": "#/$defs/role" },
        "pl": { "$ref": "#/$defs/role" },
        "senior": { "$ref": "#/$defs/role" },
        "junior": { "$ref": "#/$defs/role" }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "onExhaustion",
        "maxCalls",
        "timeoutMs",
        "repeatFailureLimit"
      ],
      "properties": {
        "onExhaustion": { "enum": ["stop", "fallback"] },
        "maxCalls": { "type": "integer", "minimum": 1, "maximum": 20 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "repeatFailureLimit": { "type": "integer", "minimum": 1 },
        "adviceBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "$comment": "Advisor calls one shared state directory may spend; core.mjs reads 6 when omitted."
        },
        "claudeAutoCompact": {
          "oneOf": [
            { "const": "auto" },
            { "type": "integer", "minimum": 100000, "maximum": 1000000 }
          ],
          "$comment": "Tokens after which a Claude role session compacts (--autocompact). core.mjs reads 250000 when omitted; \"auto\" leaves the flag off."
        },
        "supervision": {
          "type": "object",
          "$comment": "Omitted in organizations saved before this policy; core.mjs reads the defaults 900000 and 2.",
          "required": ["progressCheckMs", "unansweredLimit"],
          "additionalProperties": false,
          "properties": {
            "progressCheckMs": {
              "type": "integer",
              "minimum": 60000,
              "maximum": 86400000
            },
            "unansweredLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "experimental": {
          "type": "object",
          "$comment": "Opt-in experiments; omitted means every experiment is off.",
          "additionalProperties": false,
          "properties": {
            "jev": {
              "type": "object",
              "$comment": "TypeSafe Jev shadow judgments recorded under <state>/judgments; see references/jev.md.",
              "required": [
                "mode",
                "model",
                "points",
                "budgetPerKickoff",
                "timeoutMs"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": { "enum": ["off", "shadow"] },
                "model": {
                  "type": "string",
                  "pattern": "^jev-\\d+\\.\\d+\\.\\d+$"
                },
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "status-filter",
                      "auto-observe",
                      "model-check",
                      "failure-fallback"
                    ]
                  }
                },
                "budgetPerKickoff": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 10000
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pool": {
      "type": "object",
      "required": ["label"],
      "properties": { "label": { "type": "string", "minLength": 1 } }
    },
    "profile": {
      "type": "object",
      "required": ["provider", "account", "subscription", "model"],
      "oneOf": [{ "required": ["command"] }, { "required": ["endpoint"] }],
      "$comment": "A profile declares exactly one transport: `command` spawns a CLI, `endpoint` calls an HTTP API. core.mjs rejects a provider that cannot serve the declared transport.",
      "properties": {
        "provider": { "enum": ["claude", "codex", "agy", "ollama"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "contextTokens": { "type": "integer", "minimum": 2048 },
        "keepAlive": { "type": "string", "minLength": 1 },
        "account": { "type": "string", "minLength": 1 },
        "subscription": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "modelResolvedAtFormation": {
          "type": ["string", "null"],
          "$comment": "The host default model resolved at formation time. Null if the profile uses a fixed model or resolution was skipped."
        },
        "effort": {
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra"],
          "$comment": "Reasoning effort. Omit to keep the provider default. Each adapter in scripts/providers/ states the levels it accepts and core.mjs narrows the set from that registry: agy and ollama low|medium|high, codex low|medium|high|xhigh|max|ultra, claude low|medium|high|xhigh|max."
        },
        "pool": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "runner": {
          "type": "object",
          "required": ["kind", "mode", "accountHomeRef", "runtimeFingerprint"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "opencodex" },
            "mode": { "const": "fixed-account" },
            "accountHomeRef": { "type": "string", "minLength": 1 },
            "runtimeFingerprint": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "provider",
        "account",
        "subscription",
        "pool",
        "concurrency",
        "maxCalls"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["claude", "codex", "agy"] },
        "account": { "type": "string", "minLength": 1 },
        "subscription": { "type": "string", "minLength": 1 },
        "pool": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxCalls": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "assistantProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "role": {
      "type": "object",
      "required": ["parent", "concurrency", "attempts", "fallbacks"],
      "properties": {
        "parent": { "enum": [null, "pm", "pl", "senior", "junior"] },
        "profile": { "type": "string", "minLength": 1 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "fallbacks": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$comment": "core.mjs additionally verifies profile references, graph reachability/cycles, account binding, per-provider reasoning effort and command constraints."
}
