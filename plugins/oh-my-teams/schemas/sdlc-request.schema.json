{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oh my teams SDLC request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "goal"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "goal": { "type": "string", "minLength": 1 },
    "trustedAuthorities": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "publicKey"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "kind": { "enum": ["human", "policy", "deployment-provider"] }, "publicKey": { "type": "string", "minLength": 1 } } } }
  }
}
