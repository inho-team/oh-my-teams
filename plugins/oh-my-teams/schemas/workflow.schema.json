{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oh my teams workflow request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "goal",
    "repo",
    "tasks",
    "policy",
    "budget"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "goal": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "integrationTask": { "type": "string", "minLength": 1 },
    "staffing": {
      "type": "object",
      "$comment": "A resource-based workflow freezes the director's catalog evidence, PM choice, and task choices. workflow.mjs validates resource identity and authorization against the frozen organization."
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "New organizations use 1 PM or 2 PM+Worker. Saved legacy organizations use 1 PM; 2 +Junior; 3 +Senior; 4 +PL. A saved depth of 5 reads as 4."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "role"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "role": { "enum": ["pm", "pl", "senior", "junior", "worker"] }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRunning", "maxReviewPending"],
      "properties": {
        "maxRunning": { "type": "integer", "minimum": 1 },
        "maxReviewPending": { "type": "integer", "minimum": 1 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "maxCalls"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "maxCalls": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
