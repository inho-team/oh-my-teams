{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "docId",
    "stage",
    "kickoffId",
    "workflowId",
    "revision",
    "state",
    "author",
    "createdAt",
    "basedOnRevision",
    "reason",
    "title",
    "description",
    "assignees",
    "targetDate",
    "documentRefs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "docId": { "type": "string", "minLength": 1 },
    "stage": { "const": "implementation" },
    "kickoffId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workflowId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["open", "in-review", "resolved"] },
    "author": { "$ref": "#/$defs/author" },
    "createdAt": { "type": "string", "format": "date-time" },
    "basedOnRevision": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    },
    "reason": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "assignees": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "targetDate": { "type": ["string", "null"] },
    "documentRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^omt-doc:.+@r\\d+$" }
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "executionId"],
      "properties": {
        "role": {
          "enum": ["director", "pm", "pl", "senior", "junior", "worker"]
        },
        "executionId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
