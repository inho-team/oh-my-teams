{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orca organization",
  "type": "object",
  "required": ["schemaVersion", "revision", "name", "profiles", "roles", "policy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "profiles": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/profile" } },
    "roles": {
      "type": "object", "required": ["pm", "pl", "senior", "junior", "intern"], "additionalProperties": false,
      "properties": { "pm": { "$ref": "#/$defs/role" }, "pl": { "$ref": "#/$defs/role" }, "senior": { "$ref": "#/$defs/role" }, "junior": { "$ref": "#/$defs/role" }, "intern": { "$ref": "#/$defs/role" } }
    },
    "policy": { "type": "object", "required": ["onExhaustion", "maxCalls", "timeoutMs", "repeatFailureLimit"], "properties": { "onExhaustion": { "enum": ["stop", "fallback"] }, "maxCalls": { "type": "integer", "minimum": 1, "maximum": 20 }, "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }, "repeatFailureLimit": { "type": "integer", "minimum": 1 } } }
  },
  "$defs": {
    "profile": { "type": "object", "required": ["provider", "command", "account", "subscription", "model"], "properties": { "provider": { "enum": ["claude", "codex", "agy"] }, "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "account": { "type": "string", "minLength": 1 }, "subscription": { "type": "string", "minLength": 1 }, "model": { "type": ["string", "null"] }, "env": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" } } } },
    "role": { "type": "object", "required": ["parent", "profile", "concurrency", "attempts", "fallbacks"], "properties": { "parent": { "enum": [null, "pm", "pl", "senior", "junior", "intern"] }, "profile": { "type": "string", "minLength": 1 }, "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 }, "attempts": { "type": "integer", "minimum": 1, "maximum": 5 }, "fallbacks": { "type": "array", "items": { "type": "string" } } } }
  },
  "$comment": "core.mjs additionally verifies profile references, graph reachability/cycles, account binding and command constraints."
}
