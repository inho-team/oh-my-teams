# 프로젝트 고유값 정본 — 저장소의 `.orca/project.env` 로 복사해 채운다(커밋해도 된다: 비밀은 넣지 않는다).
# launch-worker.sh 가 읽어 TASK.md 의 {{자리표시자}} 를 채우고, lead-brief-template.md 도 이 파일을 가리킨다.
# 값은 셸 문법(따옴표 안에 한 줄). 여러 명령은 ' → ' 로 잇는다.

# 운영에서 건드리면 안 되는 것 — 워커 브리프 첫 줄에 들어간다
PROD_NOTE='오케 :8080, DB :5432/workbench, 컨테이너 wb-agy-*'
# 워커·PL 이 쓰는 격리 테스트 DB DSN(비밀번호는 환경변수 이름으로 적는다). 저장소에 .orca/worker-stack.sh 가 있으면 스택이 준 DSN 이 이 값을 덮는다(폴백용)
TEST_DSN='postgres://workbench:$TEST_DB_PASSWORD@localhost:5433/workbench_test'
# 전체 검사 명령(필터 없이). preflight/verify 에 그대로 넘긴다
CHECK_CMDS='make migrate → make seed → make test, make web-check'
# PR 검증 때 가드 커밋을 revert 한 뒤 돌릴 **빠른** 테스트 명령(전체 검사보다 좁아도 된다. 비우면 전체 검사 마지막 명령)
GUARD_CMD='TEST_DB_URL=<격리 DSN> go test -count=1 ./internal/...'   # `<격리 DSN>` 은 launch-worker.sh(워커 스택)·verify-pr.sh(--dsn 또는 자동 생성 wb_v<PR>_<role>)가 실제 URL 로 바꾼다
# VERIFY_PG_ADMIN='postgres://user:pw@127.0.0.1:5432/postgres?sslmode=disable'   # verify-pr.sh 가 격리 DB 를 만들 관리 DSN(기본값이 이것)   # ⚠️ 뒤에 `| tail` 을 붙이지 마라 — 종료코드가 tail 의 것이 된다(verify-pr.sh 는 pipefail 로 방어하지만 정본은 깨끗하게)
# (4번 예정) 검증을 돌릴 SSH 호스트. 비우면 이 머신
VERIFY_HOST=''
# PM Run id — PL 브리프 「프로젝트 고유값」 에서 쓴다. 워커용 RUN_ID 는 PL 이 launch-worker.sh --run 으로 준다
PM_RUN=''

# 역할별 구독(계정) — 비우면 기본 계정. agy 는 ~/.workbench/agy-homes/<이름>(host = 기본 HOME), codex 는 ~/.codex-<이름>(default = ~/.codex).
# 예: 주니어는 Ultra(host), 시니어는 pro 예비(backup) — 한 계정의 5시간 버킷을 역할이 나눠 쓰지 않게.
ACCOUNT_JUNIOR=''
ACCOUNT_SENIOR=''
ACCOUNT_INTERN=''
ACCOUNT_PL=''
